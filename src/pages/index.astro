---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <section class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-6" data-testid="game-filters" aria-labelledby="filter-heading">
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <h3 id="filter-heading" class="text-lg font-medium text-slate-100">Filter games</h3>
              <button
                type="reset"
                form="game-filter-form"
                class="self-start rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>

            <form id="game-filter-form" class="grid gap-6 md:grid-cols-2" data-testid="game-filter-form">
              <fieldset>
                <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
                <div class="grid gap-2 sm:grid-cols-2">
                  {categories.map((category) => (
                    <label class="flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>
            </form>

            <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count">
              Showing {games.length} {games.length === 1 ? 'game' : 'games'}
            </p>
          </div>
        </section>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div class="hidden" data-testid="filter-empty-state">
          <EmptyState text="No games match the selected filters." />
        </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('#game-filter-form');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const gameGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');

  if (filterForm && gameGrid && emptyState && resultCount) {
    const categoryInputs = Array.from(
      filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherInput = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const updateResults = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherInput?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.categoryId ?? '';
        const publisherId = card.dataset.publisherId ?? '';
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(categoryId);
        const publisherMatches = selectedPublisher === '' || selectedPublisher === publisherId;
        const isVisible = categoryMatches && publisherMatches;

        card.classList.toggle('hidden', !isVisible);
        if (isVisible) {
          visibleCount += 1;
        }
      }

      gameGrid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount > 0);
      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    };

    filterForm.addEventListener('change', updateResults);
    filterForm.addEventListener('reset', () => {
      requestAnimationFrame(updateResults);
    });
  }
</script>
